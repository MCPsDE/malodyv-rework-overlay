<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MalodyV.ReworkOverlay</AssemblyName>
    <RootNamespace>MalodyV.ReworkOverlay</RootNamespace>
    <Version>1.3.7</Version>
    <AssemblyVersion>1.3.7.0</AssemblyVersion>
    <FileVersion>1.3.7.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
    <Content Include="..\nonebot_plugin_rework\**\*"
             Exclude="..\nonebot_plugin_rework\**\__pycache__\**;..\nonebot_plugin_rework\**\*.pyc">
      <Link>nonebot_plugin_rework\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Data\ReferenceMetrics.py">
      <Link>Data\ReferenceMetrics.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\nonebot_plugin_osumania_toolkit\**\*"
             Exclude="..\nonebot_plugin_osumania_toolkit\.git\**;..\nonebot_plugin_osumania_toolkit\**\__pycache__\**;..\nonebot_plugin_osumania_toolkit\**\*.pyc">
      <Link>nonebot_plugin_osumania_toolkit\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\runtime\python\**\*"
             Exclude="..\runtime\python\**\__pycache__\**;..\runtime\python\**\*.pyc;..\runtime\python\Lib\site-packages\pip\**;..\runtime\python\Lib\site-packages\setuptools\**">
      <Link>runtime\python\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
